# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# File .env chứa mật khẩu nên KHÔNG được đưa lên Git (đã có trong .gitignore).

# --- PostgreSQL (dịch vụ db) ---
POSTGRES_USER=dapchuot
POSTGRES_PASSWORD=doi-thanh-mat-khau-database-cua-ban
POSTGRES_DB=dapchuot

# --- Tài khoản trang admin (/admin) ---
ADMIN_USER=admin
# Tối thiểu 10 ký tự
ADMIN_PASSWORD=doi-thanh-mat-khau-admin-cua-ban

# --- Khoá ký cookie đăng nhập: chuỗi ngẫu nhiên, tối thiểu 32 ký tự ---
# Tạo nhanh bằng:  openssl rand -hex 32
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu

# --- Tuỳ chọn (bỏ dấu # đầu dòng nếu muốn đổi) ---
# SESSION_TTL_HOURS=8
# LOGIN_MAX_ATTEMPTS=5
# REGISTER_MAX_PER_MINUTE=20
# PAGE_SIZE=20
# Chỉ đặt true khi chạy sau proxy HTTPS tin cậy (nginx, ngrok...)
# TRUST_PROXY=true
# COOKIE_SECURE=true
